{
  "name": "reed",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Reed — tienda online de ropa unisex (React + Express + MongoDB + Mercado Pago)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file=.env server/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node --env-file=.env server/seed.js",
    "make-admin": "node --env-file=.env server/scripts/make-admin.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@imgly/background-removal": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.0.0",
    "mongoose": "^8.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "vite": "^6.3.0"
  }
}
