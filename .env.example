# Copiá este archivo como .env (nunca subas el .env al repo)

# MongoDB Atlas → Database → Connect → Drivers
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.xxxxx.mongodb.net/reed?retryWrites=true&w=majority

# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame

# Quien se registre con este email queda como administradora
ADMIN_EMAIL=antoruizx@gmail.com

# URL pública del sitio (en local: http://localhost:5173)
SITE_URL=http://localhost:5173

# Mercado Pago → Tus integraciones → Credenciales (usá las de prueba primero)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Mercado Pago → Webhooks → Clave secreta (opcional pero recomendado)
MP_WEBHOOK_SECRET=

# Crear diseños con IA (opcional). platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high (más calidad = más caro y más lento)
OPENAI_IMAGE_QUALITY=medium
# Diseños con IA por persona por día
AI_DAILY_LIMIT=8

# Los costos de envío se editan desde Panel → Envíos y pagos

# Solo para desarrollo local
PORT=8000
